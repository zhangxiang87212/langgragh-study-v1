# sqlite 会在程序退出后保留状态；memory 只用于测试和临时实验。
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=checkpoints/research.sqlite

# 容错：最多尝试次数包含第一次调用；等待时间按指数增长并带随机抖动。
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_INTERVAL=1
LLM_RETRY_BACKOFF_FACTOR=2
LLM_RETRY_MAX_INTERVAL=30
LLM_NODE_TIMEOUT_SECONDS=120

# 预算：Token/费用设为 0 表示不限制。费用单价按每百万 Token 配置。
LLM_MAX_CALLS=30
SEARCH_MAX_ROUNDS=3
LLM_MAX_TOTAL_TOKENS=0
LLM_MAX_COST_USD=0
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Web 页面中的模型设置由每位用户自行填写，不需要在这里配置 API Key。
# 页面密钥只保存在服务端会话内存中，不会写回本文件。

# 只有使用 python -m app.main 的 CLI 用户才需要取消注释并配置以下内容：
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
# OPENAI_SEARCH_MODEL=gpt-5.4-mini
#
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 前后端分开部署时，用逗号分隔允许携带会话 Cookie 的前端 Origin。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 生产环境建议显式启用；本地 HTTP 开发保持 false。
LLM_SESSION_COOKIE_SECURE=false
